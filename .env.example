NEXT_PUBLIC_SUPABASE_URL="https://wnuucpbfiucmymxqcbyx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Used by Prisma to securely connect to your PostgreSQL database
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Pago con tarjeta (Square). Sin estas dos variables el botón "Pagar con tarjeta" no aparece en el portal.
SQUARE_ACCESS_TOKEN="your-square-access-token"
SQUARE_LOCATION_ID="your-square-location-id"
# "sandbox" para pruebas (por defecto) o "production" para cobrar de verdad.
SQUARE_ENVIRONMENT="sandbox"
# Clave de firma de la suscripción de webhooks (Square Developer → Webhooks). URL: https://app.shopusaenvios.com/api/square/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY="your-webhook-signature-key"
