generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant, usuarios y configuración
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  clients            Client[]
  orders             Order[]
  products           Product[]
  expenses           Expense[]
  shippingCategories ShippingCategory[]
  productCatalog     ProductCatalog[]
  settings           TenantSettings?
  countryRules       CountryRule[]
  counters           Counter[]
  invoices           Invoice[]
  payments           Payment[]
  consolidations     Consolidation[]
  pkgs               Pkg[]
  dispatches         Dispatch[]
  referralBenefits   ReferralBenefit[]
  custodyPackages    CustodyPackage[]
  auditLogs          AuditLog[]
  accessRequests     AccessRequest[]
  cardCheckouts      CardCheckout[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  email     String   @unique
  role      Role     @default(SUBADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  SUBADMIN
}

/// Una sola fila por tenant. Todo lo que el negocio puede cambiar sin tocar código.
model TenantSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Tasas
  taxRatePercent             Float @default(6.5)
  personalShopperRatePercent Float @default(20) // valor sugerido al crear un cliente
  cartServiceRatePercent     Float @default(10) // "Compramos tu carrito"
  referralDiscountPoints     Float @default(5) // puntos porcentuales por beneficio de referido

  // Consolidación y retención
  retentionWarningDays Int       @default(21)
  retentionMaxDays     Int       @default(30)
  dispatchCutoffAt     DateTime? // fecha/hora límite semanal para solicitar retención
  clientAlertsEnabled  Boolean   @default(true)

  // PKG
  pkgStartNumber Int @default(500)

  // Custodio de paquetería
  custodySmallFee      Float @default(3)
  custodyMediumFee     Float @default(4)
  custodyLargeFee      Float @default(5)
  deliveryBaseFee      Float @default(15)
  deliveryBaseMiles    Float @default(5)
  deliveryExtraPerMile Float @default(1.5)

  // Pagos
  paymentInstructions String?

  updatedAt DateTime @updatedAt
}

/// Reglas por país de destino. Agregar un país nuevo = agregar una fila.
model CountryRule {
  id                               String  @id @default(cuid())
  tenantId                         String
  tenant                           Tenant  @relation(fields: [tenantId], references: [id])
  name                             String // "Ecuador", "Panamá"
  codePrefix                       String // "EC", "PTY"
  active                           Boolean @default(true)
  allowDispatchWithBalance         Boolean @default(false) // ¿se despacha desde USA con saldo pendiente?
  requireFullPaymentBeforeDelivery Boolean @default(true) // ¿no se entrega con saldo pendiente?
  usesDeconsolidation              Boolean @default(false) // cajas compartidas + desconsolidación

  @@unique([tenantId, name])
}

/// Consecutivos atómicos (clientes, pedidos, facturas, despachos).
model Counter {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  key      String
  value    Int    @default(0)

  @@unique([tenantId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userName  String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Etapa 1 — Clientes y tarifas
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code     String // EC001, PTY004… generado automáticamente
  name     String
  idNumber String?
  email    String?   @unique
  country  String
  city     String
  phone    String
  birthday DateTime?
  notes    String?

  deliveryMethod  DeliveryMethod @default(STORE_PICKUP)
  deliveryAddress String?

  // Condiciones comerciales (independientes entre sí)
  serviceFeePercent  Float             @default(20) // tasa habitual de Personal Shopper
  shippingCategoryId String?
  shippingCategory   ShippingCategory? @relation(fields: [shippingCategoryId], references: [id])

  // Programa de referidos
  referredById String?
  referredBy   Client?  @relation("ClientReferrals", fields: [referredById], references: [id])
  referrals    Client[] @relation("ClientReferrals")

  // Custodio de paquetería (apagado por defecto)
  custodyActive   Boolean   @default(false)
  custodyDeadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders                   Order[]
  products                 Product[]
  invoices                 Invoice[]
  payments                 Payment[]
  consolidations           Consolidation[]
  custodyPackages          CustodyPackage[]
  accessRequests           AccessRequest[]
  cardCheckouts            CardCheckout[]
  benefitsEarned           ReferralBenefit[] @relation("BenefitReferrer")
  referralBenefitGenerated ReferralBenefit?  @relation("BenefitReferred")

  @@unique([tenantId, code])
}

/// Solicitud de acceso al portal: el cliente dice su código y su correo; Shop USA aprueba antes de ligarlos.
model AccessRequest {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  email        String // correo que declara el cliente (en minúsculas)
  phone        String // teléfono que declara; el personal lo compara con el de la ficha
  status       AccessRequestStatus @default(PENDING)
  rejectReason String?
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime            @default(now())

  @@index([status, createdAt])
  @@index([clientId])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DeliveryMethod {
  STORE_PICKUP
  HOME_DELIVERY
}

enum ShippingUnit {
  HALF_LB // se factura en fracciones de 0.5 lb
  LB // libra completa
}

model ShippingCategory {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  name       String // "Ecuador General", "Ecuador Familiar / Migrante", …
  country    String
  pricePerLb Float        @default(0) // siempre precio por libra
  unit       ShippingUnit @default(HALF_LB)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  clients Client[]

  @@unique([tenantId, name])
}

// ─────────────────────────────────────────────────────────────────────────────
// Etapas 2 y 5 — Pedidos (Personal Shopper y Compramos tu carrito)
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  number    Int
  type      OrderType   @default(PERSONAL_SHOPPER)
  status    OrderStatus @default(PENDING_PAYMENT)
  orderDate DateTime    @default(now())
  channel   String? // web, WhatsApp, otro
  notes     String?

  // Cálculo (todo queda registrado para trazabilidad)
  taxRatePercent        Float
  subtotal              Float
  taxAmount             Float
  baseServiceFeePercent Float // tasa habitual del cliente
  serviceFeePercent     Float // tasa aplicada (con beneficio de referido si correspondía)
  serviceFeeAmount      Float
  extraCharges          Float         @default(0) // p. ej. shipping cobrado por la tienda
  extraChargesNote      String?
  discountType          DiscountType?
  discountValue         Float?
  discountAmount        Float         @default(0)
  discountReason        String?
  totalAmount           Float

  // Compra a crédito / cortesía autorizada por un administrador
  courtesyAuthorized   Boolean   @default(false)
  courtesyAuthorizedBy String?
  courtesyAuthorizedAt DateTime?

  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    Product[]
  invoice     Invoice?
  benefitUsed ReferralBenefit?

  @@unique([tenantId, number])
}

enum OrderType {
  PERSONAL_SHOPPER
  CART
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  READY_TO_BUY
  PARTIALLY_PURCHASED
  PURCHASED
  RECEIVED
  CANCELLED
}

enum DiscountType {
  AMOUNT
  PERCENT
}

// ─────────────────────────────────────────────────────────────────────────────
// Producto: una sola identidad durante todo el recorrido
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  clientId String
  client   Client  @relation(fields: [clientId], references: [id])
  orderId  String? // null en Casillero
  order    Order?  @relation(fields: [orderId], references: [id])

  origin ProductOrigin
  status ProductStatus

  name      String
  quantity  Int     @default(1)
  unitPrice Float? // precio en tienda por unidad (no aplica a Casillero)
  imageUrl  String?
  storeName String?
  url       String?
  variant   String? // talla, color, modelo…
  notes     String?

  consolidationId String?
  consolidation   Consolidation? @relation(fields: [consolidationId], references: [id])
  pkgId           String?
  pkg             Pkg?           @relation(fields: [pkgId], references: [id])

  purchasedAt           DateTime?
  receivedAt            DateTime?
  destinationReceivedAt DateTime?
  deliveredAt           DateTime?
  issueNote             String? // faltante / novedad detectada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([orderId])
  @@index([consolidationId])
  @@index([pkgId])
  @@index([status])
}

enum ProductOrigin {
  PERSONAL_SHOPPER
  CASILLERO
  CART
}

enum ProductStatus {
  PENDING_PAYMENT
  READY_TO_BUY
  PURCHASED
  RECEIVED // en bodega USA (consolidado / PKG sin despachar)
  IN_TRANSIT
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

/// Catálogo de productos frecuentes (autocompletar al crear pedidos).
model ProductCatalog {
  id                   String    @id @default(cuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  name                 String
  defaultPurchaseValue Float?
  notes                String?
  timesShipped         Int       @default(0)
  lastUsedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([tenantId, name])
}

// ─────────────────────────────────────────────────────────────────────────────
// Etapa 7 — Facturas, pagos y estado de cuenta global
// Los pedidos generan cargos (facturas); los pagos pertenecen al cliente.
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  number      Int
  type        InvoiceType
  status      InvoiceStatus @default(PENDING)
  issueDate   DateTime      @default(now())
  description String?
  total       Float
  paidAmount  Float         @default(0)
  cancelledAt DateTime?

  orderId         String?        @unique
  order           Order?         @relation(fields: [orderId], references: [id])
  consolidationId String?        @unique
  consolidation   Consolidation? @relation(fields: [consolidationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines             InvoiceLine[]
  allocations       PaymentAllocation[]
  custodyPackage    CustodyPackage?     @relation("CustodyInvoice")
  custodyDeliveries CustodyPackage[]    @relation("CustodyDeliveryInvoice")

  @@unique([tenantId, number])
  @@index([clientId])
}

enum InvoiceType {
  PERSONAL_SHOPPER
  CART
  SHIPPING
  CUSTODY
  DELIVERY
  OTHER
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

model InvoiceLine {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind        InvoiceLineKind
  description String
  amount      Float // los descuentos van en negativo
  sortOrder   Int             @default(0)
}

enum InvoiceLineKind {
  PRODUCTS
  TAX
  SERVICE_FEE
  SHIPPING
  DISCOUNT
  EXTRA
  CUSTODY
  DELIVERY
  ADJUSTMENT
}

model Payment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  amount Float
  method PaymentMethod
  status PaymentStatus @default(PENDING_VERIFICATION)
  kind   PaymentKind   @default(PAYMENT)

  paidAt    DateTime      @default(now()) // fecha de la transferencia / pago
  reference String? // n.º de transferencia
  proofUrl  String? // ruta del comprobante en Storage
  note      String?
  source    PaymentSource @default(STAFF)

  // El cliente puede indicar a qué pedido/factura corresponde su pago.
  targetInvoiceId String?

  verifiedBy      String?
  verifiedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]

  @@index([clientId])
  @@index([status])
}

enum PaymentMethod {
  TRANSFER
  CARD
  CASH
  ONLINE
  CREDIT // crédito/ajuste a favor otorgado por Shop USA
  OTHER
}

enum PaymentStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  VOIDED
}

enum PaymentKind {
  PAYMENT
  CREDIT_ADJUSTMENT
}

/// Intento de pago con tarjeta en Square. El pago real (Payment) se crea solo cuando Square confirma el cobro.
model CardCheckout {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  amount          Float // lo que se abona a la cuenta del cliente
  targetInvoiceId String?
  status          CardCheckoutStatus @default(CREATED)

  squareLinkId    String?
  squareOrderId   String?  @unique
  squarePaymentId String?  @unique
  paymentId       String?  @unique // Payment creado al confirmarse el cobro

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([clientId])
}

enum CardCheckoutStatus {
  CREATED
  PAID
  FAILED
}

enum PaymentSource {
  CLIENT
  STAFF
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Referidos
// ─────────────────────────────────────────────────────────────────────────────

model ReferralBenefit {
  id         String @id @default(cuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  referrerId String // quien refirió (recibe el beneficio)
  referrer   Client @relation("BenefitReferrer", fields: [referrerId], references: [id])
  referredId String @unique // el referido: genera como máximo un beneficio
  referred   Client @relation("BenefitReferred", fields: [referredId], references: [id])

  sourceInvoiceId String? // primera compra válida del referido
  status          BenefitStatus @default(AVAILABLE)
  usedOrderId     String?       @unique
  usedOrder       Order?        @relation(fields: [usedOrderId], references: [id])
  usedAt          DateTime?
  voidedReason    String?
  createdAt       DateTime      @default(now())

  @@index([referrerId, status])
}

enum BenefitStatus {
  AVAILABLE
  USED
  VOIDED
}

// ─────────────────────────────────────────────────────────────────────────────
// Etapa 3 — Consolidado del cliente (se pesa una vez, los productos se controlan uno a uno)
// ─────────────────────────────────────────────────────────────────────────────

model Consolidation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  status             ConsolidationStatus @default(OPEN)
  decision           DispatchDecision    @default(DISPATCH) // por defecto se despacha
  decidedAt          DateTime?
  retentionStartedAt DateTime? // no se reinicia cuando llegan productos nuevos

  realWeight      Float     @default(0)
  weightUpdatedAt DateTime?

  // Se congela al cerrar para el despacho
  billableWeight       Float?
  pricePerLb           Float?
  billingUnit          ShippingUnit?
  shippingCategoryName String?
  shippingCost         Float?
  closedAt             DateTime?

  // Alertas automáticas al cliente por retención prolongada (una vez por nivel)
  warningAlertSentAt DateTime?
  maxAlertSentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  invoice  Invoice?

  @@index([clientId, status])
}

enum ConsolidationStatus {
  OPEN
  CLOSED // listo para despacho
}

enum DispatchDecision {
  DISPATCH
  HOLD
}

// ─────────────────────────────────────────────────────────────────────────────
// Etapas 6 y 8 — PKG (caja física) y Despacho
// ─────────────────────────────────────────────────────────────────────────────

model Pkg {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  number         Int
  country        String
  status         PkgStatus @default(IN_PREPARATION)
  trackingNumber String? // guía de la transportadora (referencia externa)
  carrier        String?
  notes          String?
  closedAt       DateTime?

  dispatchId String?
  dispatch   Dispatch? @relation(fields: [dispatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([tenantId, number])
}

enum PkgStatus {
  IN_PREPARATION
  CLOSED
  IN_TRANSIT
  AT_DESTINATION
  READY_FOR_PICKUP
  DELIVERED
}

model Dispatch {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  number      Int
  country     String
  date        DateTime
  status      DispatchStatus @default(DRAFT)
  confirmedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pkgs Pkg[]

  @@unique([tenantId, number])
}

enum DispatchStatus {
  DRAFT
  CONFIRMED
}

// ─────────────────────────────────────────────────────────────────────────────
// Etapa 9 — Custodio de paquetería (Orlando)
// ─────────────────────────────────────────────────────────────────────────────

model CustodyPackage {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  receivedAt DateTime      @default(now())
  size       CustodySize
  fee        Float
  storeNote  String?
  status     CustodyStatus @default(IN_CUSTODY)

  deliveredAt    DateTime?
  deliveryMethod CustodyDelivery?
  deliveryMiles  Float?
  deliveryFee    Float?

  invoiceId         String?  @unique
  invoice           Invoice? @relation("CustodyInvoice", fields: [invoiceId], references: [id])
  deliveryInvoiceId String?
  deliveryInvoice   Invoice? @relation("CustodyDeliveryInvoice", fields: [deliveryInvoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
}

enum CustodySize {
  SMALL
  MEDIUM
  LARGE
}

enum CustodyStatus {
  IN_CUSTODY
  DELIVERED
}

enum CustodyDelivery {
  PICKUP
  DELIVERY
}

// ─────────────────────────────────────────────────────────────────────────────
// Contabilidad (gastos del negocio)
// ─────────────────────────────────────────────────────────────────────────────

model Expense {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  expenseDate    DateTime
  category       String
  description    String
  country        String
  originalAmount Float
  adjustedAmount Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
